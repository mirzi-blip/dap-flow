# DAP Flow — environment variables
# Copy to .env for local work; set the same keys on the host (Vercel → Settings →
# Environment Variables). Never commit real values.

# ── Supabase (build-time, shipped in the browser bundle) ─────────────────────
VITE_SUPABASE_URL=https://uohhloqkikemvustxnpa.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Email (server-side only, used by the functions in api/) ──────────────────
# The Gmail account the app authenticates with, and an app password generated
# from that same account (not the account's login password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# What recipients see in the From line. Leave blank to send as GMAIL_USER.
# Set this when the app should send as a different address — it must be the
# authenticated account itself or an alias verified on it under
# Gmail → Settings → Accounts → "Send mail as", or Gmail silently rewrites the
# From back to GMAIL_USER.
MAIL_FROM_ADDRESS=spg@ipi.ph

# Display name beside the address. Defaults to "DAP Flow (No Reply)".
MAIL_FROM_NAME=

# Where replies go. Defaults to an unmonitored no-reply address.
MAIL_REPLY_TO=
